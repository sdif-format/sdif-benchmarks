# sdif-benchmarks — environment variable reference
#
# Copy to .env and fill in the values you need.
# Variables marked (required) must be set for the relevant benchmark to run.
# Variables marked (optional) have defaults shown in comments.


# ---------------------------------------------------------------------------
# API credentials
# ---------------------------------------------------------------------------

# (required for Claude tokenizer and retrieval benchmark)
ANTHROPIC_API_KEY=<your-anthropic-api-key>

# (required for LLaMA tokenizer when SDIF_LLAMA_LOCAL_ONLY is not set)
HF_TOKEN=<your-huggingface-token>


# ---------------------------------------------------------------------------
# Tokenizer toggles
# Each tokenizer is enabled by default unless disabled with 0.
# Exception: Claude requires explicit opt-in (SDIF_BENCHMARK_CLAUDE=1).
# ---------------------------------------------------------------------------

# Set to 0 to skip the TOON tokenizer pass.
SDIF_BENCHMARK_TOON=1

# Set to 0 to skip the tokenx pass.
SDIF_BENCHMARK_TOKENX=1

# Set to 0 to skip the LLaMA tokenizer pass.
SDIF_BENCHMARK_LLAMA=1

# Set to 1 to enable the Claude tokenizer pass (requires ANTHROPIC_API_KEY).
SDIF_BENCHMARK_CLAUDE=0


# ---------------------------------------------------------------------------
# Retrieval accuracy benchmark
# ---------------------------------------------------------------------------

# Set to 1 to enable the retrieval accuracy benchmark (requires ANTHROPIC_API_KEY).
SDIF_BENCHMARK_RETRIEVAL=0

# Maximum number of questions per document in the retrieval benchmark. (default: 8)
SDIF_RETRIEVAL_MAX_QUESTIONS=8


# ---------------------------------------------------------------------------
# Suite control
# ---------------------------------------------------------------------------

# Comma-separated list of benchmark names to skip.
# Known names: token, context, roundtrip, delta, retrieval
SDIF_BENCHMARK_SKIP=

# Set to 1 to print per-document verbose output during runs.
SDIF_BENCHMARK_VERBOSE=0

# Set to 0 to prevent suite from overriding env vars already set in the shell.
SDIF_ENV_OVERRIDE=1


# ---------------------------------------------------------------------------
# Model and tokenizer configuration
# ---------------------------------------------------------------------------

# Claude model used for Claude tokenizer and retrieval benchmark. (default: claude-haiku-4-5-20251001)
SDIF_CLAUDE_MODEL=claude-haiku-4-5-20251001

# Tiktoken encoding name passed to tiktoken.get_encoding(). (default: cl100k_base)
SDIF_TIKTOKEN_ENCODING=cl100k_base

# HuggingFace model ID or local path for the LLaMA tokenizer. (default: meta-llama/Meta-Llama-3-8B)
SDIF_LLAMA_TOKENIZER=meta-llama/Meta-Llama-3-8B

# Set to 1 to load LLaMA tokenizer from local cache only, without downloading. (default: 0)
SDIF_LLAMA_LOCAL_ONLY=0

# Fallback chars-per-token ratio used by tokenx when no real tokenizer is available.
SDIF_TOKENX_DEFAULT_CHARS_PER_TOKEN=4.0

# Colon-separated list of directories tokenx searches for plugin tokenizers.
SDIF_TOKENX_RESOLVE_DIRS=


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------

# Directory where benchmark results are written. (default: sdif-benchmarks/results/)
SDIF_BENCHMARK_OUTPUT_DIR=

# Directory containing golden SDIF fixtures used as benchmark corpus.
# (default: sdif-benchmarks/corpus/ or the core repo examples/golden/)
SDIF_BENCHMARK_GOLDEN_DIR=

# Absolute path to the core sdif repo. (default: parent directory of sdif-benchmarks/)
SDIF_CORE_REPO=
